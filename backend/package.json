{
  "name": "@ido-grow/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "node --env-file=.env.local ../node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "node --env-file=.env.local ../node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma",
    "prisma:validate": "node --env-file=.env.local ../node_modules/prisma/build/index.js validate --schema prisma/schema.prisma",
    "auth:create-local-user": "npm run build && node --env-file=.env.local dist/authentication/create-local-user.js",
    "auth:create-demo-users": "node dist/authentication/create-demo-users.js",
    "seed:matching:local": "npm run build && node --env-file=.env.local dist/matching/seed-local-matching-data.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:local": "node --env-file=.env.local ../node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:e2e:local": "node --env-file=.env.local ../node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand",
    "test:integration:local": "node --env-file=.env.local ../node_modules/jest/bin/jest.js --config test/jest-integration.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@prisma/client": "6.19.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.4.2",
    "prisma": "6.19.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
