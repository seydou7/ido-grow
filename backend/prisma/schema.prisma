generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(320)
  passwordHash String       @db.VarChar(255)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  sessions     Session[]
  memberships  Membership[]
  auditEvents  AuditEvent[]
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventType     String   @db.VarChar(100)
  outcome       String   @db.VarChar(32)
  actorType     String   @db.VarChar(32)
  actorUserId   String?  @db.Uuid
  targetType    String   @db.VarChar(100)
  targetId      String?  @db.VarChar(128)
  correlationId String   @db.Uuid
  occurredAt    DateTime @db.Timestamptz(6)
  metadata      Json     @default("{}") @db.JsonB
  actorUser     User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([correlationId])
  @@index([targetType, targetId])
}

model Organisation {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(200)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  sites       Site[]
  memberships Membership[]
}

model Site {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  name           String       @db.VarChar(200)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId])
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organisationId String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
