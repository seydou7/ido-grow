  initiatedByRole       String             @db.VarChar(50)
  organisationContextId String?            @db.Uuid
  provider              String             @db.VarChar(100)
  model                 String             @db.VarChar(100)
  status                String             @default("RUNNING") @db.VarChar(50)
  targetResourceType    String?            @db.VarChar(100)
  targetResourceId      String?            @db.VarChar(128)
  summary               String?            @db.Text
  confidence            Float?
  structuredOutput      Json?              @db.JsonB
  failureCategory       String?            @db.VarChar(100)
  failureReason         String?            @db.Text
  startedAt             DateTime           @default(now()) @db.Timestamptz(6)
  completedAt           DateTime?          @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  initiatedByUser       User               @relation("AgentRunInitiatedByUser", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  organisation          Organisation?      @relation("AgentRunOrganisation", fields: [organisationContextId], references: [id], onDelete: SetNull)
  proposals             AgentProposal[]
  toolExecutions        ToolExecutionLog[]

  @@index([agentKey])
  @@index([status])
  @@index([initiatedByUserId])
  @@index([targetResourceType, targetResourceId])
  @@index([createdAt])
}

model AgentProposal {
  id                String             @id @default(uuid()) @db.Uuid
  runId             String             @db.Uuid
  proposalType      String             @db.VarChar(100)
  toolKey           String             @db.VarChar(100)
  structuredPayload Json               @db.JsonB
  confidence        Float
  status            String             @default("PROPOSED") @db.VarChar(50)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)

  run               AgentRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  approvalRequests  ApprovalRequest[]
  toolExecutions    ToolExecutionLog[]

  @@index([runId])
  @@index([status])
  @@index([toolKey])
  @@index([createdAt])
}

model ApprovalRequest {
  id              String         @id @default(uuid()) @db.Uuid
  proposalId      String         @db.Uuid
  runId           String         @db.Uuid
  requestedAt     DateTime       @default(now()) @db.Timestamptz(6)
  requiredRole    String         @default("TRADER") @db.VarChar(50)
  status          String         @default("PENDING") @db.VarChar(50)
  decidedByUserId String?        @db.Uuid
  decidedAt       DateTime?      @db.Timestamptz(6)
  decisionNote    String?        @db.Text
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  proposal        AgentProposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  decidedByUser   User?          @relation("ApprovalRequestDecidedByUser", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([proposalId])
  @@index([runId])
  @@index([status])
  @@index([requiredRole])
  @@index([createdAt])
}

model ToolExecutionLog {
  id                  String         @id @default(uuid()) @db.Uuid
  runId               String         @db.Uuid
  proposalId          String?        @db.Uuid
  approvalId          String?        @db.Uuid
  toolKey             String         @db.VarChar(100)
  actorRole           String         @db.VarChar(50)
  actorUserId         String?        @db.Uuid
  safeInputSummary    Json           @db.JsonB
  status              String         @db.VarChar(50)
  startedAt           DateTime       @default(now()) @db.Timestamptz(6)
  completedAt         DateTime?      @db.Timestamptz(6)
  safeResultReference Json?          @db.JsonB
  failureCategory     String?        @db.VarChar(100)
  failureReason       String?        @db.Text
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)

  run                 AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  proposal            AgentProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([proposalId])
  @@index([toolKey])
  @@index([status])
  @@index([createdAt])
}

