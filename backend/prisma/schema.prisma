  createdByUser              User          @relation("ContractCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedByUser            User?         @relation("ContractConfirmedByUser", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
