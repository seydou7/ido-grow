  toOrganisation       Organisation?          @relation("DPPCustodyToOrganisation", fields: [toOrganisationId], references: [id], onDelete: SetNull)

  @@unique([dppId, sourceType, sourceId, milestone])
  @@index([dppId])
  @@index([lotId])
  @@index([milestone])
  @@index([occurredAt])
}

