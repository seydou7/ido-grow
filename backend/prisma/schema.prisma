model DPPEvent {
  id                         String                 @id @default(uuid()) @db.Uuid
  dppId                      String                 @db.Uuid
  lotId                      String                 @db.Uuid
  eventType                  String                 @db.VarChar(50)
  occurredAt                 DateTime               @db.Timestamptz(6)
  recordedAt                 DateTime               @default(now()) @db.Timestamptz(6)
  location                   String?                @db.VarChar(255)
  responsibleOrganisationId  String?                @db.Uuid
  responsibleUserId          String?                @db.Uuid
  sourceType                 String                 @db.VarChar(50)
  sourceId                   String                 @db.VarChar(100)
  verificationStatus         String                 @default("RECORDED") @db.VarChar(50)
  metadata                   Json?                  @default("{}") @db.JsonB

  dpp                        DigitalProductPassport @relation(fields: [dppId], references: [id], onDelete: Cascade)
