model Shipment {
  id                         String              @id @default(uuid()) @db.Uuid
  shipmentNumber             String              @unique @db.VarChar(50)
  contractId                 String              @db.Uuid
  createdByUserId            String              @db.Uuid
  buyerOrganisationId        String              @db.Uuid
  supplierOrganisationId     String              @db.Uuid
  origin                     String?             @db.VarChar(255)
  destination                String?             @db.VarChar(255)
  shipmentQuantity           Float
  quantityUnit               String              @db.VarChar(50)
  requestedPickupDate        DateTime?           @db.Timestamptz(6)
  requestedDeliveryDate      DateTime?           @db.Timestamptz(6)
  transportRequirements      String?             @db.Text
  packagingRequirements      String?             @db.Text
  specialHandlingRequirements String?            @db.Text
  notes                      String?             @db.Text
  selectedFreightQuotationId String?             @db.Uuid
  status                     String              @default("PLANNING") @db.VarChar(50)

  scheduledPickupAt          DateTime?           @db.Timestamptz(6)
  actualPickupAt             DateTime?           @db.Timestamptz(6)
  deliveredAt                DateTime?           @db.Timestamptz(6)
  deliveredLocation          String?             @db.VarChar(255)
  deliveryNotes              String?             @db.Text
  previousStatus             String?             @db.VarChar(50)
  delayReason                String?             @db.Text
  delayReportedAt            DateTime?           @db.Timestamptz(6)
  revisedExpectedDeliveryDate DateTime?          @db.Timestamptz(6)
  disputeReason              String?             @db.Text
  disputeReportedAt          DateTime?           @db.Timestamptz(6)
  disputeResolvedAt          DateTime?           @db.Timestamptz(6)
  disputeResolutionNotes     String?             @db.Text
  closedAt                   DateTime?           @db.Timestamptz(6)
  closedByUserId             String?             @db.Uuid

  createdAt                  DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime            @updatedAt @db.Timestamptz(6)

  contract                   Contract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdByUser              User                @relation("ShipmentCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  closedByUser               User?               @relation("ShipmentClosedByUser", fields: [closedByUserId], references: [id], onDelete: SetNull)
  buyerOrganisation          Organisation        @relation("ShipmentBuyerOrganisation", fields: [buyerOrganisationId], references: [id], onDelete: Restrict)
  supplierOrganisation       Organisation        @relation("ShipmentSupplierOrganisation", fields: [supplierOrganisationId], references: [id], onDelete: Restrict)
  selectedFreightQuotation   FreightQuotation?   @relation("ShipmentSelectedQuotation", fields: [selectedFreightQuotationId], references: [id], onDelete: SetNull)
  logisticsRequests          LogisticsRequest[]
  freightQuotations          FreightQuotation[]  @relation("ShipmentFreightQuotations")
  trackingEvents             ShipmentTrackingEvent[]
  documents                  ShipmentDocument[]
  discrepancies              ShipmentDiscrepancy[]
  costReconciliation         ShipmentCostReconciliation?
  settlements                Settlement[]

  @@index([contractId])
  @@index([buyerOrganisationId])
  @@index([supplierOrganisationId])
  @@index([status])
  @@index([createdAt])
}

model LogisticsRequest {
