DATABASE_URL="postgresql://ido_grow_app:replace-with-local-password@127.0.0.1:55432/ido_grow?schema=public"
IDO_GROW_RUNTIME_ENV="local"
IDO_GROW_TEST_USER_EMAIL="synthetic-user@example.test"
IDO_GROW_TEST_USER_PASSWORD="replace-with-a-local-only-password"

# AI Platform Provider Configuration (MVP Target: DeepSeek via OpenAI-compatible endpoint)
# Defaults to "deterministic" (DeterministicFakeAiProvider, zero cost, offline dev / test)
AI_PROVIDER="deterministic"

