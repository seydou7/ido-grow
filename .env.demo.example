# PostgreSQL Database Configuration (Internal Docker Container)
POSTGRES_DB=ido_grow_demo
POSTGRES_USER=ido_grow_user
POSTGRES_PASSWORD=replace_with_secure_random_db_password

# Application Runtime Configuration
NODE_ENV=production
IDO_GROW_RUNTIME_ENV=demo
IDO_GROW_DEMO_DOMAIN=demo.idogrow.com
IDO_GROW_DEMO_ORIGIN=https://demo.idogrow.com

# Demo Account Credentials (Provisioned via explicit command)
IDO_GROW_DEMO_SUPPLIER_EMAIL=supplier@demo.idogrow.com
IDO_GROW_DEMO_SUPPLIER_PASSWORD=replace_with_secure_supplier_password
IDO_GROW_DEMO_BUYER_EMAIL=buyer@demo.idogrow.com
IDO_GROW_DEMO_BUYER_PASSWORD=replace_with_secure_buyer_password
IDO_GROW_DEMO_TRADER_EMAIL=trader@demo.idogrow.com
IDO_GROW_DEMO_TRADER_PASSWORD=replace_with_secure_trader_password
